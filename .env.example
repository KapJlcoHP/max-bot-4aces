# Токен бота из письма организаторов (без кавычек)
MAX_BOT_TOKEN=paste_your_token_here

# База данных (SQLite для MVP; для Postgres сменить DSN)
DATABASE_URL=sqlite:///./database/app.db

# Публичный https-адрес мини-апа (заполнить после деплоя на VPS).
# Показывается ботом в подсказках; сама кнопка «Открыть приложение»
# ссылается на мини-ап, привязанный к боту в business.max.ru.
MINIAPP_PUBLIC_URL=

# Домен сервера для HTTPS (нужен для docker compose --profile prod, сервис caddy).
# Поддомен DuckDNS без «https://», например: medroute-4aces.duckdns.org
MEDROUTE_DOMAIN=

# ТОЛЬКО для локальной разработки в обычном браузере (вне MAX):
# true = принимать запросы без подписанного initData (демо-пользователь «Анна»).
# В проде обязательно false / удалить переменную!
DEV_BYPASS_AUTH=false

# Тестовый доступ к API для автоматической проверки платформой (см. DATA-API.yaml).
# Запрос с заголовком X-Test-Token, равным этому значению, работает под тестовой
# учётной записью. Пусто/удалено = выключено. Секрет — в репозиторий не попадает.
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(32))"
TEST_API_TOKEN=

# Разрешённые CORS-источники для dev-сервера Vite
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
